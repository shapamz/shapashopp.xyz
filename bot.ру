import os
import threading
from flask import Flask
import telebot
from telebot import types

BOT_TOKEN = os.environ.get("BOT_TOKEN", "").strip()
KASPI_INFO = os.environ.get(
    "KASPI_INFO",
    "Kaspi KZ: нөмір мен аты-жөнді Render баптауына жаз",
).strip()
ADMIN_USERNAME = os.environ.get("ADMIN_USERNAME", "tatuka11").lstrip("@").strip()
SITE_URL = os.environ.get("SITE_URL", "https://shapamz.github.io/shapashopp.xyz/").strip()

if not BOT_TOKEN:
    raise RuntimeError("BOT_TOKEN табылмады! Render Environment Variables ішіне BOT_TOKEN қос.")

bot = telebot.TeleBot(BOT_TOKEN)
app = Flask(__name__)

PRODUCTS = {
    "phantom": {
        "name": "Phantom (Android+ios)",
        "status": "ONLINE",
        "tariffs": [
            ("6h", "200 ₸"),
            ("12h", "300 ₸"),
            ("1 Day (24h)", "450 ₸"),
            ("3 Day (72h)", "900 ₸"),
            ("7 Day (168h)", "1300 ₸"),
        ],
    },
    "drip": {
        "name": "Drip Wire (android+ IOS)",
        "status": "ONLINE",
        "tariffs": [
            ("6h", "250 ₸"),
            ("12h", "350 ₸"),
            ("1 Day (24h)", "500 ₸"),
            ("3 Day (72h)", "1200 ₸"),
            ("7 Day (168h)", "1500 ₸"),
        ],
    },
}


@app.route("/")
def health():
    return "SHAPA MODZ bot is running", 200


def run_web():
    port = int(os.environ.get("PORT", 10000))
    app.run(host="0.0.0.0", port=port)


def welcome_text():
    return (
        "🚀 *ДОБРО ПОЖАЛОВАТЬ В SHAPA MODZ SHOP*\n\n"
        "⚡ Мгновенная выдача после оплаты\n"
        "🛡 Проверенные моды Free Fire (Android / iOS)\n"
        "💬 Поддержка 24/7\n\n"
        "Выберите действие ниже:"
    )


def main_menu_keyboard():
    kb = types.InlineKeyboardMarkup(row_width=1)
    kb.add(types.InlineKeyboardButton("🌐 Открыть сайт магазина", url=SITE_URL))
    kb.add(types.InlineKeyboardButton("🛒 Открыть магазин в боте", callback_data="open_shop"))
    kb.add(types.InlineKeyboardButton("💬 Поддержка", url=f"https://t.me/{ADMIN_USERNAME}"))
    return kb


def shop_keyboard():
    kb = types.InlineKeyboardMarkup(row_width=1)
    kb.add(types.InlineKeyboardButton("🔥 Phantom (Android+ios) • ONLINE", callback_data="prod_phantom"))
    kb.add(types.InlineKeyboardButton("⚡ Drip Wire (android+ IOS) • ONLINE", callback_data="prod_drip"))
    kb.add(types.InlineKeyboardButton("⬅️ Назад в меню", callback_data="back_home"))
    return kb


def tariffs_keyboard(prod_key):
    kb = types.InlineKeyboardMarkup(row_width=1)
    for idx, (period, price) in enumerate(PRODUCTS[prod_key]["tariffs"]):
        kb.add(
            types.InlineKeyboardButton(
                f"🔑 {period} — {price}",
                callback_data=f"tariff_{prod_key}_{idx}",
            )
        )
    kb.add(types.InlineKeyboardButton("⬅️ К товарам", callback_data="open_shop"))
    return kb


def payment_keyboard(prod_key, idx):
    kb = types.InlineKeyboardMarkup(row_width=1)
    kb.add(types.InlineKeyboardButton("🔴 KASPI KZ", callback_data=f"pay_{prod_key}_{idx}"))
    kb.add(types.InlineKeyboardButton("⬅️ Назад к тарифам", callback_data=f"prod_{prod_key}"))
    return kb


@bot.message_handler(commands=["start"])
def send_welcome(message):
    bot.send_message(
        message.chat.id,
        welcome_text(),
        parse_mode="Markdown",
        reply_markup=main_menu_keyboard(),
    )


@bot.callback_query_handler(func=lambda call: True)
def handle_callback(call):
    data = call.data
    chat_id = call.message.chat.id
    msg_id = call.message.message_id

    if data == "back_home":
        bot.edit_message_text(
            welcome_text(),
            chat_id,
            msg_id,
            parse_mode="Markdown",
            reply_markup=main_menu_keyboard(),
        )

    elif data == "open_shop":
        text = (
            "🛒 *КАТАЛОГ СОФТА — SHAPA MODZ*\n\n"
            "• *Phantom (Android+ios)* — 🟢 ONLINE\n"
            "• *Drip Wire (android+ IOS)* — 🟢 ONLINE\n\n"
            "Выберите товар:"
        )
        bot.edit_message_text(
            text,
            chat_id,
            msg_id,
            parse_mode="Markdown",
            reply_markup=shop_keyboard(),
        )

    elif data.startswith("prod_"):
        prod_key = data.replace("prod_", "", 1)
        prod = PRODUCTS.get(prod_key)
        if not prod:
            return
        text = (
            f"📦 *{prod['name']}*\n"
            f"🟢 Статус: *{prod['status']}*\n\n"
            "🔑 *Выберите тариф:*"
        )
        bot.edit_message_text(
            text,
            chat_id,
            msg_id,
            parse_mode="Markdown",
            reply_markup=tariffs_keyboard(prod_key),
        )

    elif data.startswith("tariff_"):
        parts = data.split("_")
        prod_key = parts[1]
        idx = int(parts[2])
        prod = PRODUCTS[prod_key]
        period, price = prod["tariffs"][idx]

        text = (
            "💳 *СПОСОБ ОПЛАТЫ*\n\n"
            f"Товар: *{prod['name']}*\n"
            f"Тариф: *{period}*\n"
            f"К оплате: *{price}*\n\n"
            "Выберите способ оплаты ниже:"
        )
        bot.edit_message_text(
            text,
            chat_id,
            msg_id,
            parse_mode="Markdown",
            reply_markup=payment_keyboard(prod_key, idx),
        )

    elif data.startswith("pay_"):
        parts = data.split("_")
        prod_key = parts[1]
        idx = int(parts[2])
        prod = PRODUCTS[prod_key]
        period, price = prod["tariffs"][idx]

        text = (
            "🔴 *KASPI KZ*\n\n"
            f"Товар: *{prod['name']}*\n"
            f"Тариф: *{period}*\n"
            f"К оплате: *{price}*\n\n"
            "Реквизиты для оплаты:\n"
            f"`{KASPI_INFO}`\n\n"
            "1️⃣ Переведите точную сумму.\n"
            "2️⃣ Отправьте скриншот чека сюда в бот или напишите админу.\n"
            f"3️⃣ После проверки ключ будет отправлен вам (связь: @{ADMIN_USERNAME})."
        )
        kb = types.InlineKeyboardMarkup(row_width=1)
        kb.add(types.InlineKeyboardButton("💬 Написать админу", url=f"https://t.me/{ADMIN_USERNAME}"))
        kb.add(types.InlineKeyboardButton("⬅️ Назад", callback_data=f"tariff_{prod_key}_{idx}"))
        bot.edit_message_text(
            text,
            chat_id,
            msg_id,
            parse_mode="Markdown",
            reply_markup=kb,
        )

    bot.answer_callback_query(call.id)


@bot.message_handler(content_types=["photo", "text", "document"])
def handle_user_message(message):
    if message.text and message.text.startswith("/"):
        return
    bot.send_message(
        message.chat.id,
        f"✅ Хабарламаң қабылданды! Төлем чегі немесе сұрағың бойынша @{ADMIN_USERNAME} тексереді.",
    )


if __name__ == "__main__":
    threading.Thread(target=run_web, daemon=True).start()
    bot.infinity_polling(skip_pending=True)
